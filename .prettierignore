# Vendored / generated trees that ship third-party markdown we do not
# control. Listed here (rather than relying on prettier's default
# ignore set) so the explicit-file path used by the PR-gate job
# matches the same ignore semantics as the full-repo lint-on-main job.

# Build outputs
**/dist/
**/build/

# Local scratch space
tmp/
temp/

# JS/TS deps
**/node_modules/

# Embedded operator chart is a mirror from charts/witwave-operator/
# (sync'd by scripts/sync-embedded-chart.sh). Lint the canonical
# source, not the embedded copy — drift between them is enforced
# separately by the existing chart-sync CI guard.
clients/ww/internal/operator/embedded/

# controller-gen output. Regenerated from operator/api/v1alpha1 Go
# types via `make manifests` (CRD schemas, ClusterRole, webhook
# configurations). Touching the rendered output creates a per-pass
# revert cycle for nova's code-format.
charts/witwave-operator/crds/
operator/config/crd/bases/
operator/config/rbac/role.yaml
operator/config/webhook/manifests.yaml

# Python tooling caches
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.venv/
**/.tox/

# Agent runtime artifacts (gitignored at runtime, but be defensive)
.agents/self/*/logs/
.agents/test/*/logs/
.claude/memory/
.claude/projects/
.claude/sessions/
.claude/backups/

# License files often have intentional formatting that prettier
# would reflow against the original wording. We don't write LICENSE
# files; don't lint them.
LICENSE
LICENSE.md
**/LICENSE
**/LICENSE.md

# SOPS-encrypted secrets. Prettier collapses the encryptor's native
# 4-space → 2-space indent; the file still decrypts because the SOPS
# MAC is computed over the decrypted-and-canonicalised structure, but
# operator tooling and `git diff` reviews assume the encryptor's native
# layout. Leave the bytes-on-disk alone so review surface stays
# unambiguous. (Recommended by nova 2026-05-17 04:30Z after per-pass
# revert cycles on .secrets/*.sops.yaml.)
.secrets/

# Release pipeline workflow YAML. Hand-aligned matrix `include:` rows
# and long `outputs:` / `cache-from:` / `cache-to:` values straddle
# `${{ ... }}` expression boundaries; YAML plain-scalar folding is
# semantically equivalent but the release-critical-path risk of a
# parser-edge-case mis-fold is not worth the readability gain. (Same
# nova flag.)
.github/workflows/release.yaml

# Composite action invoked from the release pipeline. Prettier reflows
# hand-wrapped folded-block `description:` strings into longer lines —
# semantically equivalent but reduces readability of a CI gate that
# operators / iris read often. (Same nova flag.)
.github/actions/wait-for-sibling-ci/
